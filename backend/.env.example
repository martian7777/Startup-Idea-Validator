# Copy to .env and fill in. Never commit .env.

# --- Gemini ---------------------------------------------------------------
# Search grounding requires billing enabled and a Gemini 3 series model.
GEMINI_API_KEY=

# --- Supabase -------------------------------------------------------------
# App connection: transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migrations only: direct connection, port 5432. Alembic refuses the pooler.
DATABASE_DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Cost control ---------------------------------------------------------
# Gemini 3 bills per search query the model executes, not per request.
MAX_SEARCHES_PER_AGENT=6
MAX_SEARCHES_PER_RUN=25

# Set false to run the pipeline without grounded search (no search billing).
ENABLE_SEARCH_GROUNDING=true

# --- App ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
